# Neon Serverless Postgres Connection URL
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# School Location for Weather Auto-Detection
DEFAULT_WEATHER_CITY=IIT Kendriya Vidyalaya, Kharagpur

# Gradio & UI Settings
MOUNT_GRADIO=True
GRADIO_ANALYTICS_ENABLED=True
