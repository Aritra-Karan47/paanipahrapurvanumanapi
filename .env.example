# ==============================================================================
# Neon Serverless Postgres Configuration
# ==============================================================================
# Neon pooled connection string (recommended for serverless & high-concurrency):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string (alternative):
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Decomposed Postgres connection parameters (alternative to DATABASE_URL):
PGHOST=ep-example-pooler.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=YOUR_PASSWORD
PGPORT=5432
PGSSLMODE=require

# ==============================================================================
# Application & Weather Service Settings
# ==============================================================================
DEFAULT_WEATHER_CITY=IIT Kendriya Vidyalaya, Kharagpur
WEATHER_CACHE_HOURS=8
PORT=8000

# ==============================================================================
# Gradio & UI Settings
# ==============================================================================
MOUNT_GRADIO=True
GRADIO_ANALYTICS_ENABLED=False
